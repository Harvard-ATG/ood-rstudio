#!/bin/bash
# generated-for: @APP@
#SBATCH --job-name=@APP@
#SBATCH --partition=general
#SBATCH --cpus-per-task=1
#SBATCH --time=00:15:00
#SBATCH --output=@APP@-%j.out
#
# Run an R script on the cluster using the SAME container image and the SAME
# package library as your RStudio session, so a job produces what you see there.
#
#     sbatch @WRAPPER@ my_script.R
#
# NEED MORE, OR YOUR OWN NAME ON THE JOB? You do not have to edit anything -
# options on the command line beat the settings above:
#
#     sbatch -c 4 -t 02:00:00 -J hw3 @WRAPPER@ my_script.R
#
# Check on it:      squeue -u $USER
# Read the output:  cat @APP@-<jobid>.out     (lands where you submitted from,
#                                              so submit from your own folder)
#
# WANT TO CHANGE WHAT IT DOES? Copy it first. Your copy is yours, and nothing
# will ever overwrite it:
#
#     cp @WRAPPER@ my-run.sh
#
# ---------------------------------------------------------------------------
# The image and library below are read from the course folder at RUN time, not
# frozen into this file. That is what lets a copy taken today still use the
# right image next month: change the course, and every copy follows.
#
# The two assignments are a fallback for the case where that file does not
# exist yet - a course being tested before its folder is provisioned.
IMAGE=@IMAGE@
R_LIB=@RLIBS@
COURSE_ENV=@COURSE_ENV@
[ -r "$COURSE_ENV" ] && . "$COURSE_ENV"
: "${IMAGE:?no IMAGE - course-env.sh is missing and no fallback was baked in}"
: "${R_LIB:?no R_LIB - course-env.sh is missing and no fallback was baked in}"

# Spack is only here to provide the `apptainer` command.
. /shared/spack/share/spack/setup-env.sh
spack env activate apptainer

echo "Running $1 on $(hostname)"

# -B makes the course folder visible inside the container; R_LIBS_USER tells R
# where the course packages are. The image supplies R itself - which is the
# whole point, because the compute node's own R cannot load packages compiled
# against the container's R.
apptainer exec -B /shared/courseSharedFolders \
  --env R_LIBS_USER="$R_LIB" \
  "$IMAGE" Rscript "$@"
