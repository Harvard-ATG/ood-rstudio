#!/usr/bin/env bash

this_script="template/script.sh.erb"

log() {
    echo -e "[$(date -Iseconds)][${this_script}] $1"
}

<%- session_dir = session.staged_root %>

# Benchmark info
log "Starting main script"

# Set working directory to home directory
cd "${HOME}"

<% if context.respond_to?('custom_num_gpus') && !context.custom_num_gpus.blank? && context.custom_num_gpus.to_i > 0 %>
spack_environment="apptainer-gpu"
<% else %>
spack_environment="apptainer"
<% end %>
apptainer_image_dir="/shared/apptainerImages"
rstudio_container="<%= context.imagefile %>"

# Load the required environment
setup_env () {
  # Load spack
  spack_root="/shared/spack"
  log "Spack root: $spack_root"
  . $spack_root/share/spack/setup-env.sh
  log "Activated spack install."

  # Load the required environment
  log "Loading spack environment: $spack_environment"

  spack env activate $spack_environment

  log "Spack environment loaded."
}

setup_env

export WORKING_DIR="<%= session_dir %>"

#
# Start RStudio Server
#
# PAM auth helper used by RStudio
export RSTUDIO_AUTH="$WORKING_DIR/bin/auth"

# Set up R library paths
R_LIBS_USER="/shared/home/$USER/R/%p-library/%v"
<%= context.respond_to?('r_libpath') ? "export R_LIBS_USER=\"${R_LIBS_USER}:#{context.r_libpath}\"" : "" %>

# Generate an `rsession` wrapper script
export RSESSION_WRAPPER_FILE="$WORKING_DIR/rsession.sh"
(
umask 077
sed 's/^ \{2\}//' > "$WORKING_DIR/rsession.sh" << EOL
  #!/usr/bin/env bash
  set -x
  echo "The rsession script is running"
  export RSESSION_LOG_FILE="$WORKING_DIR/rsession.log"
  exec &>>"\${RSESSION_LOG_FILE}"
  set -x

  export R_LIBS_SITE="${R_LIBS_SITE}"
  export TZ="US/Eastern"
  <% if context.respond_to?('slurm_enabled') && context.slurm_enabled.to_s == "true" %>
  # Slurm-enabled sub-apps only: RStudio rebuilds PATH for the session, so this
  # is what puts sbatch/squeue in front of R itself - system("sbatch ...") from
  # the console depends on it. Terminal shells are handled by the profile.d
  # drop-in in the bind block below. \${PATH} is escaped so it expands at run
  # time in the container, not when this wrapper is written.
  export PATH="/opt/slurm/bin:\${PATH}"
  <% end %>
  export HOME="$HOME"
  export RSTUDIO_AUTH="$WORKING_DIR/bin/auth"
  export MODULEPATH_ROOT="$MODULEPATH_ROOT"
  export MODULEPATH="$MODULEPATH"
  export LMOD_PKG="$LMOD_PKG"
  
  env

  echo "Launching rsession..."
  # The --r-libs-user flag is REQUIRED. Removing it was tried and reverted.
  #
  # R_LIBS_USER is exported earlier in this file and it does reach this wrapper -
  # the env dump above shows it. But rserver starts rsession as a further
  # process and does not pass it down, the same way it does not pass down PATH.
  # Without the flag, R falls back to computing its own default user library and
  # the course library disappears from .libPaths() entirely:
  #
  #   [1] /shared/home/<netid>/R/x86_64-pc-linux-gnu-library/4.5   <- R's default
  #   [2] /usr/local/lib/R/site-library
  #   [3] /usr/local/lib/R/library                                 <- no course lib
  #
  # The tell is that [1] is exactly what R computes from $HOME on its own, so a
  # home library in the list is not evidence the variable arrived.
  exec rsession --r-libs-user "${R_LIBS_USER}" "\${@}"
EOL
)
chmod 700 "$WORKING_DIR/rsession.sh"

# server log directory
mkdir -p "$WORKING_DIR/logs"

APPTAINER_HOME=$HOME

# Bind folders to the container file system
SING_BIND_LIST=(
  "-B" "/shared/courseSharedFolders"
  "-B" "/shared/spack"
  "-B" "$WORKING_DIR/etc/rstudio:/etc/rstudio"
)
# ---------------------------------------------------------------------------
# Slurm client injection - OPT IN, one sub-app at a time.
#
# WHAT CHANGED: previously nothing in this app could reach the scheduler, because
# the container carries no Slurm client and no way to authenticate. This block
# lets the container use the client and the munge socket that already exist on
# the compute node the session is running on. Nothing is installed and no image
# is rebuilt; these are bind mounts of host paths.
#
# WHO GETS IT: only a sub-app whose form sets slurm_enabled: "true" AND lists
# slurm_enabled under form: (OOD passes only form:-listed attributes into
# context). Every other sub-app skips this block entirely and renders exactly as
# it did before.
#
# WHY EACH PIECE IS HERE - each one was a failure we hit and fixed, in order:
#   1. -B /opt/slurm      the client binaries and their plugins. Bound at the
#                         SAME path, because the client dlopens plugins from
#                         /opt/slurm/lib/slurm. On this cluster /opt/slurm is
#                         NFS-exported from the head node, so it is identical on
#                         every compute node.
#   2. -B /run/munge      the socket that mints the credential slurmctld trusts.
#                         Not data - an IPC channel to the node's own munged.
#   3. libmunge           resolved with readlink -f, never hardcoded: the patch
#                         level differs between machines (portal 2.0.0, compute
#                         nodes 2.0.1).
#   4. merged passwd/group  WITHOUT THIS EVERY SLURM COMMAND FAILS with
#                         "Invalid user for SlurmUser slurm". slurm.conf names
#                         SlurmUser=slurm, and the container's /etc/passwd has
#                         neither that account nor the LDAP user. Deduplicated
#                         because Apptainer already injects the calling user.
#   5. PATH set twice     APPTAINERENV_APPEND_PATH alone is NOT enough: RStudio
#                         rebuilds the session PATH, so it never reaches an
#                         rserver-spawned shell. See the profile.d drop-in below
#                         (terminal) and the rsession.sh wrapper above (R).
#
# Verified on pc-stage 2026-08-27: job 772 submitted jobs 773/774 from inside
# rstudio-base.sif as an LDAP user; session job 778 ran squeue and submitted
# job 779 from the RStudio terminal.
# ---------------------------------------------------------------------------
<% if context.respond_to?('slurm_enabled') && context.slurm_enabled.to_s == "true" %>
log "Slurm injection enabled for this sub-app"

# --- 1. Build an /etc/passwd and /etc/group the Slurm client can use ----------
#
# WHY AT ALL: /etc/passwd and /etc/group are identifier translation maps - they
# turn account and group names into the uid/gid numbers the kernel enforces on,
# and back again. A container image carries its own copies, baked in when the
# image was built on Docker Hub: root, daemon, rstudio and friends. It has never
# heard of this cluster's "slurm" account, and never heard of any LDAP user.
# Two things break as a result:
#   - slurm.conf contains the literal text SlurmUser=slurm. The client resolves
#     that name while PARSING ITS CONFIG, before doing anything else. It cannot,
#     so it aborts with "Invalid user for SlurmUser slurm" followed by "Unable
#     to process configuration file". This is name resolution, not permissions.
#   - the session's own user has no entry either, so the uid has no name, home
#     or shell - and RStudio then fails in ways that point nowhere near here.
#
# HOW: start from the image's own file (so container-internal accounts survive),
# append the few records the host can resolve, dedupe, and bind the result over
# /etc/passwd and /etc/group inside the container.
#
# WHAT THIS IS NOT: a grant of any kind. A map is not a key. Access is still
# decided by the kernel on the numeric ids the process already carries, and
# trust between Slurm components comes from munge (step 2), not from this file.
_IMG="${apptainer_image_dir}/${rstudio_container}"

# run the container purely to read its own two files back out of the image
apptainer exec "$_IMG" cat /etc/passwd > "$WORKING_DIR/passwd" 2>/dev/null
apptainer exec "$_IMG" cat /etc/group  > "$WORKING_DIR/group"  2>/dev/null

# ask the HOST to resolve the records the image lacks. getent consults whatever
# the host knows - local files for service accounts, LDAP via sssd for people -
# so the numbers match the host by construction rather than by hand.
#   slurm     : because slurm.conf names it. This is the fatal one.
#   munge     : so tools printing the socket's owner show a name, not 412
#   $(id -un) : the person running this session. Required because binding a file
#               over /etc/passwd REPLACES the entry apptainer injects for the
#               caller - omit it and the session has a uid with no name.
getent passwd slurm munge "$(id -un)" >> "$WORKING_DIR/passwd"
getent group  slurm munge              >> "$WORKING_DIR/group"

# ...and this user's own groups, so group NAMES resolve inside the container:
# ls -l in the course folder then prints canvas170320-staff, not 1168564.
# NOTE: this is not what grants access to that folder. The numeric gid list is
# already in the process credentials and the container inherits it regardless.
for _g in $(id -Gn); do getent group "$_g" >> "$WORKING_DIR/group"; done

# ...and every member of this course, so squeue and sacct show netids instead of
# bare uid numbers. Binding a file over /etc/passwd means ONLY the records in
# that file resolve: without this the session owner has a name and every other
# person prints as a number, leaving faculty, staff and the dev team unable to
# see whose job is whose.
#
# WHY THE LIST IS BUILT IN ERB AND NOT HERE: this script runs on the compute
# node, and compute nodes cannot enumerate group membership - SSSD there returns
# a group with an empty or near-empty member list (measured: 1 name, against 179
# on the portal). What compute nodes CAN do is resolve a name that is handed to
# them, which is how the session owner already gets a passwd entry above.
#
# ERB is evaluated on the PORTAL, where the directory answers in full. So the
# roster is looked up there and pasted in as a plain list of names; the passwd
# lookups still happen here, on the node. Each machine does only what it can.
#
# The group is taken from the OUTER course folder's own group ownership - the
# enrollment group - so nothing is configured and nothing is guessed:
#   /shared/courseSharedFolders/170320outer  ->  canvas170320-1168563
# and the path comes from r_libpath, which the form already supplies.
#
# A netid in the group with no account behind it - in the roster but never
# provisioned - simply produces no line. Not an error, and nothing to handle:
# group membership is not the same thing as an account.
<%
  _course_roster = begin
    require 'etc'
    _rlib = context.respond_to?('r_libpath') ? context.r_libpath.to_s : ''
    if _rlib.include?('/R/')
      # dirname of the library's course dir is the outer folder, whose group is
      # the enrollment group; %% on the shell side would do the same cut.
      _gname = Etc.getgrgid(File.stat(File.dirname(_rlib.split('/R/').first)).gid).name
      _gname.start_with?('canvas') ? Etc.getgrnam(_gname).mem.join(' ') : ''
    else
      ''
    end
  rescue StandardError
    ''   # never let a roster lookup break session startup
  end
%>
_ROSTER="<%= _course_roster %>"
if [ -n "$_ROSTER" ]; then
  # getent takes many keys in one call, so a couple of hundred names cost one
  # process rather than a couple of hundred.
  getent passwd $_ROSTER >> "$WORKING_DIR/passwd"
  log "added $(printf '%s\n' $_ROSTER | grep -c .) course members to passwd"
else
  log "no course roster resolved - only the session owner will show a name"
fi

# apptainer already injected the calling user into the container's passwd, so
# after the append that record appears twice. Harmless - first match wins - but
# confusing to read later, so keep the first occurrence of each line.
awk '!seen[$0]++' "$WORKING_DIR/passwd" > "$WORKING_DIR/passwd.tmp" && mv "$WORKING_DIR/passwd.tmp" "$WORKING_DIR/passwd"
awk '!seen[$0]++' "$WORKING_DIR/group"  > "$WORKING_DIR/group.tmp"  && mv "$WORKING_DIR/group.tmp"  "$WORKING_DIR/group"

# --- 2. Bind in the pieces the container is missing ---------------------------
#
# Every one of these already exists on the compute node this session is running
# on. The container simply cannot see them, and a bind is what puts a host path
# inside its view. Nothing is installed, and no image is rebuilt.

# libmunge is resolved at run time, never hardcoded: the patch level differs
# between machines (portal 2.0.0, compute nodes 2.0.1), so a fixed path works in
# one place and breaks in the other.
MUNGELIB=$(readlink -f /usr/lib64/libmunge.so.2)

# the client binaries (sbatch/squeue/sacct) and their plugin directory. Bound at
# the SAME path deliberately: the client dlopens plugins from /opt/slurm/lib/slurm,
# so a relocated bind would load nothing. /opt/slurm is NFS-exported from the
# head node, so it is the same version at the same path on every compute node.
SING_BIND_LIST+=("-B" "/opt/slurm")

# the munge socket. Not data - an IPC channel to the node's own munged, which
# seals a credential carrying the caller's REAL uid; slurmctld verifies that
# seal with the shared key. This is the only piece here carrying any authority,
# and the container cannot mint one itself.
SING_BIND_LIST+=("-B" "/run/munge")

# the library the Slurm auth plugin dlopens to use that socket. Bound to a side
# path rather than over /usr/lib64, which would shadow the container's own
# libraries and break far more than it fixed.
SING_BIND_LIST+=("-B" "${MUNGELIB}:/opt/hostlib/libmunge.so.2")

# the two files built in step 1, shown in place of the image's copies
SING_BIND_LIST+=("-B" "$WORKING_DIR/passwd:/etc/passwd")
SING_BIND_LIST+=("-B" "$WORKING_DIR/group:/etc/group")

# --- 3. Make the bound pieces findable ----------------------------------------
#
# Binding makes files EXIST inside the container; these make them DISCOVERABLE.
# Both halves are needed - a bind with nothing on PATH is indistinguishable from
# "command not found".
export APPTAINERENV_APPEND_PATH="/opt/slurm/bin"
export APPTAINERENV_LD_LIBRARY_PATH="/opt/slurm/lib:/opt/hostlib:${LD_LIBRARY_PATH}"
export APPTAINERENV_SLURM_CONF="/opt/slurm/etc/slurm.conf"

# ...but APPTAINERENV_APPEND_PATH only reaches the process apptainer starts.
# RStudio REBUILDS the environment for each session, so it never reaches a
# user's Terminal pane or R console. The tell, when this was diagnosed: even
# /usr/lib/rstudio-server/bin was missing from $PATH, though rstudio.script.sh
# prepends it explicitly. So PATH is set again in the two places RStudio does
# not rebuild: here via /etc/profile.d for interactive shells, and in the
# rsession.sh heredoc earlier in this file for R itself, so that
# system("sbatch ...") works from the console as well as the terminal.
printf '%s\n' 'export PATH="/opt/slurm/bin:$PATH"' > "$WORKING_DIR/zz-slurm.sh"
SING_BIND_LIST+=("-B" "$WORKING_DIR/zz-slurm.sh:/etc/profile.d/zz-slurm.sh")

log "Slurm client bound: munge=$MUNGELIB"

# --- 4. Leave the user a batch wrapper they can actually use ------------------
#
# Being able to type sbatch is not the same as knowing what to type. A job has
# to activate spack, run the right image, and point R at the course library -
# three things that are easy to get subtly wrong, and whose values live in this
# sub-app's form rather than anywhere a student can see. So generate the wrapper
# here, where those values are known, instead of asking anyone to keep a
# hand-written copy in step with the form.
#
# WHERE IT GOES depends on who is launching, and there are two INDEPENDENT
# checks below - not an if/elif chain, because someone who is both staff and an
# admin needs both to happen:
#
#   1. can write the course folder  -> refresh the class copy in job-tools/
#   2. is an OOD admin              -> a personal copy in $HOME, for testing
#      a student                    -> nothing at all
#
# A student holding no copy is the point: they cannot hold a STALE copy. They
# copy the class one when they want their own, and even that copy reads the
# image and library from course-env.sh at run time, so it cannot drift.

_SUBAPP="${SLURM_JOB_NAME##*/}"          # local/stat139.yml.erb -> "stat139"
[ -z "$_SUBAPP" ] && _SUBAPP="course"

# The course folder is the library path with /R/... cut off. Note that %% gives
# back the WHOLE string when there is no /R/ in it, which would point at the
# library itself - so require that the cut actually happened.
_RLIBS="<%= context.respond_to?('r_libpath') ? context.r_libpath : '' %>"
_COURSE_DIR=""
if [ -n "$_RLIBS" ] && [ "${_RLIBS%%/R/*}" != "$_RLIBS" ]; then
  _COURSE_DIR="${_RLIBS%%/R/*}"
fi
_TOOLS="${_COURSE_DIR:+$_COURSE_DIR/job-tools}"

# render <template> <destination> <mode> - written to a temp file in the same
# directory and moved into place, because rename is atomic within a filesystem:
# two staff launching at once, or a student copying mid-write, must never see a
# half-written script.
_install() {
  # $1 staged file (OOD already rendered it), $2 destination, $3 mode.
  # Write to a temp file in the destination directory and mv into place: two
  # staff launching at once, or a student copying mid-write, must never see a
  # half-written script.
  [ -f "${JOBROOT}/$1" ] || { log "staged file missing: $1"; return 1; }
  _tmp="$2.$$.tmp"
  cp "${JOBROOT}/$1" "$_tmp" 2>/dev/null || { rm -f "$_tmp"; return 1; }
  chmod "$3" "$_tmp" && mv -f "$_tmp" "$2"
}

# --- check 1: staff and faculty refresh the class copy ----------------------
# [ -w ] rather than group membership: writing is what actually matters, and it
# needs no staff list, no extra attribute, and no guess about group names. It is
# also why this is not tied to user_role - someone can be an admin AND staff.
if [ -n "$_TOOLS" ] && [ -d "$_COURSE_DIR" ] && [ -w "$_COURSE_DIR" ]; then
  mkdir -p "$_TOOLS" && chmod 755 "$_TOOLS"
  # NB: the SHARED image path, not the node-local /tmp cache the GPU branch may
  # use for this session - the job lands on a different node.
  _install run-r-job.sh  "$_TOOLS/run-r-job.sh"  755
  _install course-env.sh "$_TOOLS/course-env.sh" 644
  _install README.md     "$_TOOLS/README.md"     644
  log "refreshed course job-tools: $_TOOLS"
else
  log "not refreshing course job-tools (not writable by $(id -un)): ${_TOOLS:-unset}"
fi

# --- check 2: admins get a personal copy, for testing ------------------------
# This exists for the dev team, who typically launch a course BEFORE its folder
# is provisioned or before Grouper has propagated their access - so the branch
# above does nothing and there would otherwise be nothing to test with.
#
# The name carries both the sub-app and the fact that it is a test artefact,
# because a home directory is shared across every course a person is in, and
# because either half has to stand on its own if the file is moved or copied
# somewhere else mid-testing. It is the production name plus two suffixes, so
# it trims back to that name from the right:
#
#     run-r-job-<sub-app>-test.sh -> run-r-job-<sub-app>.sh -> run-r-job.sh
#
# Overwritten on every launch, because it is a testing artefact and never
# anyone's personal file.
if [ "<%= context.respond_to?('user_role') ? context.user_role : '' %>" = "admin" ]; then
  _WRAPPER_TEST="run-r-job-${_SUBAPP}-test.sh"
  _install run-r-job.sh "$HOME/$_WRAPPER_TEST" 755 \
    && log "wrote admin test wrapper: $HOME/$_WRAPPER_TEST"
fi
<% end %>

# Add GPU support if GPUs are requested
GPU_FLAG=""
<% if context.respond_to?('custom_num_gpus') && !context.custom_num_gpus.blank? && context.custom_num_gpus.to_i > 0 %>
GPU_FLAG="--nv"
log "GPU support enabled with --nv flag"

CUDA_HOST="/usr/local/cuda-12.8"
if [ -d "$CUDA_HOST" ]; then
  log "Found CUDA 12.8 on host. Setting up container environment..."
  
  # 1. Bind the host CUDA 12.8 to /usr/local/cuda inside container (replaces rocker's old CUDA)
  SING_BIND_LIST+=("-B" "${CUDA_HOST}:/usr/local/cuda")
  
  # 2. Inject environment variables so R session sees them (Zero-Config)
  export APPTAINERENV_CUDA_HOME="/usr/local/cuda"
  
  # Add CUDA utilities to PATH via symlinked /usr/local/cuda (avoids version-specific brittleness)
  # /usr/local/cuda/bin contains wrappers (ncu, nsys) that invoke the correct version-specific binary
  export APPTAINERENV_PATH="/usr/local/cuda/bin:${PATH}"
  export APPTAINERENV_LD_LIBRARY_PATH="${CUDA_HOST}/lib64:${LD_LIBRARY_PATH}"
  
  log "CUDA 12.8 injected into APPTAINERENV_PATH and bound to /usr/local/cuda"
else
  log "WARNING: CUDA 12.8 not found at $CUDA_HOST, torch may default to CPU"
fi

# Cache container on local storage for performance
# APPTAINER_LOCAL_CACHE="/opt/apptainerImages/${rstudio_container}"
# if [ ! -f "$APPTAINER_LOCAL_CACHE" ]; then
#   mkdir -p "$(dirname $APPTAINER_LOCAL_CACHE)"
#   cp "/shared/apptainerImages/${rstudio_container}" "$APPTAINER_LOCAL_CACHE"
# fi
# container_image="$APPTAINER_LOCAL_CACHE"

# Cache container on local storage for performance
APPTAINER_LOCAL_CACHE="/tmp/apptainerImages/${rstudio_container}"
if [ ! -f "$APPTAINER_LOCAL_CACHE" ]; then
  mkdir -p "$(dirname $APPTAINER_LOCAL_CACHE)"
  cp "/shared/apptainerImages/${rstudio_container}" "$APPTAINER_LOCAL_CACHE"
fi
container_image="$APPTAINER_LOCAL_CACHE"

<% else %>
container_image="${apptainer_image_dir}/${rstudio_container}"
<% end %>

SING_BINDS="${SING_BIND_LIST[@]}"
log "SING_BINDS=${SING_BINDS}"
log "Container image: $container_image"

# Launch the RStudio Server
log "Starting RStudio"
apptainer exec $GPU_FLAG $SING_BINDS "$container_image" ${JOBROOT}/rstudio.script.sh

log "Apptainer logs:\n$(apptainer instance list --logs)"