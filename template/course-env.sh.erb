<%-
  _rlib   = context.respond_to?('r_libpath') ? context.r_libpath.to_s : ''
  _course = _rlib.sub(%r{/R/.*\z}, '')
  _tools  = _course.empty? ? '' : "#{_course}/job-tools"
  _image  = "/shared/apptainerImages/#{context.imagefile}"
-%>
# Generated by the RStudio app when a member of the teaching staff starts a
# session. Do not edit by hand - it is rewritten on every staff launch.
#
# These are the only two values a batch job needs that differ between courses.
# They live here, rather than inside run-r-job.sh, so that a student's own copy
# of that script cannot go stale: the script reads this file every time it runs,
# so changing the image or the library here reaches every copy at once.
IMAGE=<%= _image %>
R_LIB=<%= _rlib %>
