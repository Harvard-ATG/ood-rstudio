---
# GPU resource allocation
# If custom_num_gpus is set and > 0, request GPUs via --gpus-per-node

<%-
if custom_num_gpus.blank?
  gpuArg = ""
else
  gpuArg = "- \"--gpus-per-node=#{custom_num_gpus.to_i}\""
end
-%>

# The resources below belong to the INTERACTIVE SESSION itself - the Slurm job
# that runs RStudio. They are not inherited by jobs a user submits from inside
# the session: an sbatch run from the RStudio terminal carries its own #SBATCH
# directives and is scheduled independently. Raising cpus here gives a bigger
# RStudio; it does not give bigger batch jobs.
batch_connect:
  template: "basic"
  conn_params:
    - csrf_token

script:
  native:
    - "--nodes=1"
    - "--cpus-per-task=<%= custom_num_cores.blank? ? 1 : custom_num_cores.to_i %>"
    <%= gpuArg.to_s %>
